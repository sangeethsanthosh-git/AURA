# AURA Voice Assistant Environment Configuration

# Ollama LLM Settings (use 127.0.0.1 on Windows to avoid IPv6 localhost lookup delay)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_REQUEST_TIMEOUT=30.0
OLLAMA_KEEP_ALIVE=15m

# Faster-Whisper STT Settings (CPU INT8 for 0MB VRAM overhead on RTX 2050)
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1

# Audio Capture & Silence Detection
SILENCE_DURATION_SECONDS=0.9

# TTS Engine Selection ('qwen3' for ultra-humanized voice, 'piper' for lightweight offline ONNX)
TTS_ENGINE=qwen3

# Qwen3-TTS Settings (https://github.com/QwenLM/Qwen3-TTS)
# Default model: 0.6B CustomVoice (optimized for 4GB RTX 2050 & responsive conversational speed)
# Options: 'Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice', 'Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice'
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# Preset Speakers: Serena (Warm, gentle), Vivian (Bright, expressive), Ryan (Natural male), Aiden (Conversational male)
QWEN_TTS_SPEAKER=Serena
QWEN_TTS_INSTRUCT=Speak in a warm, natural, and expressive conversational tone.
QWEN_TTS_DEVICE=cuda

# Piper TTS Settings (Fallback / Offline ONNX)
PIPER_MODEL_PATH=assets/voices/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=assets/voices/en_US-lessac-medium.onnx.json

# Audio Output Settings
AUDIO_SAMPLE_RATE=22050

# Wikipedia Deep Search & Images Settings
WIKIPEDIA_ENABLED=true
WIKIPEDIA_TIMEOUT=6.0
WIKIPEDIA_MAX_ARTICLES=3
WIKIPEDIA_MAX_IMAGES=6
