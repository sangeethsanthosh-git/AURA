{
  "name": "aura-voice-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "AURA AI Voice & Desktop Assistant",
  "author": "AURA Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "app:desktop": "electron electron/main.cjs",
    "desktop": "concurrently -k -s first \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "dist:exe": "npm run build && electron-builder --win --dir",
    "dist:installer": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.aura.assistant",
    "productName": "AURA",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
